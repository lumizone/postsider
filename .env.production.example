# PostSider SaaS — Production Environment Template
# Domain: app.postsider.com
#
# ⚠️  DO NOT commit real secrets to this file!
# The deploy.sh script will replace CHANGE_ME placeholders with secure random values.
# For existing deployments, set secrets directly on the server or use a secret manager.
# ──────────────────────────────────────────────────────────────────────────────

# === Required Settings ═══════════════════════════════════════════════════════
DATABASE_URL="postgresql://${POSTGRES_USER:-postsider}:${POSTGRES_PASSWORD:-CHANGE_ME_DB_PASSWORD}@postsider-postgres:5432/${POSTGRES_DB:-postsider_prod}"
REDIS_URL="redis://postsider-redis:6379"
JWT_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64"

# Dedicated key for encrypting reversible secrets at rest (provider client
# secrets, instance credentials) using AES-256-GCM. REQUIRED for production —
# without it the app falls back to the weaker legacy AES-256-CBC scheme derived
# from JWT_SECRET. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32"

# Production security: MUST stay UNSET (leave commented out). The code checks
# truthiness, so even "false" enables insecure mode (no session cookie -> login
# fails). Only uncomment for local HTTP development.
# NOT_SECURED=true

# URLs — all behind nginx reverse proxy
FRONTEND_URL="https://app.postsider.com"
NEXT_PUBLIC_BACKEND_URL="https://app.postsider.com/api"
BACKEND_INTERNAL_URL="http://localhost:3000"
BACKEND_URL="https://app.postsider.com"

# Public data-deletion instructions page returned by the Meta data-deletion
# callback (/meta/data-deletion/:app). Optional — when unset, the callback
# returns its own built-in status page under BACKEND_URL.
# DATA_DELETION_URL="https://example.com/data-deletion"

# Frontend build-time flags (baked into the JS bundle by Next.js).
# Keep NEXT_PUBLIC_SELF_HOSTED=true for a self-hosted instance (hides SaaS-only UI).
NEXT_PUBLIC_SELF_HOSTED="true"
NEXT_PUBLIC_VERSION="1.0.0"

# === Temporal ════════════════════════════════════════════════════════════════
TEMPORAL_ADDRESS="postsider-temporal:7233"
# REQUIRED on the instance that runs background crons: missingPostWorkflow
# (hourly re-queue of posts that missed their publish window — the self-healing
# safety net), evergreenWorkflow (recycling) and mediaCleanupWorkflow (90-day
# media retention). Without it none of them ever start — silently.
RUN_CRON="true"

# === Registration & General ══════════════════════════════════════════════════
IS_GENERAL="true"
DISABLE_REGISTRATION="false"
# Frontend copy of the gate (baked into the JS bundle at BUILD time). When
# "true", /register shows a private-beta whitelist card instead of the form
# and Google sign-in is hidden on /login. Keep in sync with the flag above.
NEXT_PUBLIC_DISABLE_REGISTRATION="false"

# === Storage — MinIO (self-hosted S3) ════════════════════════════════════════
STORAGE_PROVIDER="minio"
MINIO_ENDPOINT="http://postsider-minio:9000"
MINIO_ACCESS_KEY="CHANGE_ME_MINIO_ACCESS_KEY"
MINIO_SECRET_KEY="CHANGE_ME_MINIO_SECRET_KEY"
MINIO_BUCKET="postsider-media"
MINIO_PUBLIC_URL="https://app.postsider.com/storage"

# === Email (uncomment when ready) ════════════════════════════════════════════
# RESEND_API_KEY=""
# EMAIL_FROM_ADDRESS="noreply@postsider.com"
# EMAIL_FROM_NAME="PostSider"

# === Social Media API Settings (add as needed) ═══════════════════════════════
X_URL=""
X_API_KEY=""
X_API_SECRET=""
# Optional X flags: set to "true" to skip fetching X analytics / to strip
# links from published X posts.
# DISABLE_X_ANALYTICS=""
# STRIP_LINKS_FROM_X_POSTS=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""
# Google Business Profile (separate OAuth app from YouTube)
GOOGLE_GMB_CLIENT_ID=""
GOOGLE_GMB_CLIENT_SECRET=""
# Instagram standalone (Instagram Login API — separate from FACEBOOK_APP_*,
# which powers Instagram-via-Facebook)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
WHOP_CLIENT_ID=""
# Telegram — ONE shared platform bot (BotFather). Users add this bot to their
# channel as admin and run /connect <code>; required for connect + publishing.
TELEGRAM_TOKEN=""
TELEGRAM_BOT_NAME=""
# Bot username shown in the frontend connect modal (usually = TELEGRAM_BOT_NAME).
# NEXT_PUBLIC_* is baked into the JS bundle at BUILD time: to take effect it must
# also be passed as a build arg (Dockerfile ARG/ENV + docker-compose build.args),
# like NEXT_PUBLIC_BACKEND_URL. Unset, the frontend falls back to the cloud bot.
NEXT_PUBLIC_TELEGRAM_BOT_NAME=""
# Farcaster via Neynar: SECRET_KEY = Neynar API key, CLIENT_ID = Sign In With
# Neynar (SIWN) client id. Authorize your app origin in the Neynar dev portal.
NEYNAR_CLIENT_ID=""
NEYNAR_SECRET_KEY=""

# === AI (optional) ═══════════════════════════════════════════════════════════
# Platform AI powers Post Checker and caption rewrite for EVERY organization,
# metered per plan (`ai_uses_per_month` in pricing.ts). Set AI_API_KEY to turn
# it on; without it each organization must bring its own key in
# Settings (stored per-org in ProviderCredentials).
# AI_PROVIDER: openai | deepseek | gemini. AI_MODEL defaults per provider
# (gpt-4.1 / deepseek-chat / gemini-2.5-flash).
# AI_API_KEY takes precedence over OPENAI_API_KEY — see services/ai.flag.ts.
AI_PROVIDER="deepseek"
AI_API_KEY=""
AI_MODEL="deepseek-v4-flash"

# Legacy fallback, only used when AI_API_KEY is empty.
OPENAI_API_KEY=""

# === Misc ════════════════════════════════════════════════════════════════════
# Public API: requests per minute, per organization.
PUBLIC_API_RATE_LIMIT=60
# Dashboard API: requests per hour, per IP.
DASHBOARD_RATE_LIMIT=3000
NEXT_PUBLIC_DISCORD_SUPPORT=""
NEXT_PUBLIC_POLOTNO=""

# === Payment / Billing (Polar.sh — Merchant of Record) ══════════════════════
# Without POLAR_ACCESS_TOKEN, all orgs get ULTIMATE tier (all features)
POLAR_ACCESS_TOKEN=""
POLAR_SERVER="production"
POLAR_WEBHOOK_SECRET=""
POLAR_ORGANIZATION_ID=""
# Plan tier -> Polar product id mapping: see .env.example (POLAR_PRODUCT_*)
FEE_AMOUNT=0.05

# === Database credentials (used by docker-compose) ═══════════════════════════
POSTGRES_USER=postsider
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=postsider_prod

# === MinIO credentials (used by docker-compose — must match above) ═══════════
# Already set via MINIO_ACCESS_KEY / MINIO_SECRET_KEY above

# === DbGate ═══════════════════════════════════════════════════════════════════
DBGATE_PASSWORD=CHANGE_ME_DBGATE_PASSWORD
