# PostSider SaaS — Production Environment Template
# Domain: app.postsider.com
#
# ⚠️  DO NOT commit real secrets to this file!
# The deploy.sh script will replace CHANGE_ME placeholders with secure random values.
# For existing deployments, set secrets directly on the server or use a secret manager.
# ──────────────────────────────────────────────────────────────────────────────

# === Required Settings ═══════════════════════════════════════════════════════
DATABASE_URL="postgresql://${POSTGRES_USER:-postsider}:${POSTGRES_PASSWORD:-CHANGE_ME_DB_PASSWORD}@postsider-postgres:5432/${POSTGRES_DB:-postsider_prod}"
REDIS_URL="redis://postsider-redis:6379"
JWT_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64"

# Dedicated key for encrypting reversible secrets at rest (provider client
# secrets, instance credentials) using AES-256-GCM. REQUIRED for production —
# without it the app falls back to the weaker legacy AES-256-CBC scheme derived
# from JWT_SECRET. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32"

# Production security: MUST stay unset/false.
NOT_SECURED="false"

# URLs — all behind nginx reverse proxy
FRONTEND_URL="https://app.postsider.com"
NEXT_PUBLIC_BACKEND_URL="https://app.postsider.com/api"
BACKEND_INTERNAL_URL="http://localhost:3000"
BACKEND_URL="https://app.postsider.com"

# Frontend build-time flags (baked into the JS bundle by Next.js).
# Keep NEXT_PUBLIC_SELF_HOSTED=true for a self-hosted instance (hides SaaS-only UI).
NEXT_PUBLIC_SELF_HOSTED="true"
NEXT_PUBLIC_VERSION="1.0.0"

# === Temporal ════════════════════════════════════════════════════════════════
TEMPORAL_ADDRESS="postsider-temporal:7233"

# === Registration & General ══════════════════════════════════════════════════
IS_GENERAL="true"
DISABLE_REGISTRATION="false"

# === Storage — MinIO (self-hosted S3) ════════════════════════════════════════
STORAGE_PROVIDER="minio"
MINIO_ENDPOINT="http://postsider-minio:9000"
MINIO_ACCESS_KEY="CHANGE_ME_MINIO_ACCESS_KEY"
MINIO_SECRET_KEY="CHANGE_ME_MINIO_SECRET_KEY"
MINIO_BUCKET="postsider-media"
MINIO_PUBLIC_URL="https://app.postsider.com/storage"

# === Email (uncomment when ready) ════════════════════════════════════════════
# RESEND_API_KEY=""
# EMAIL_FROM_ADDRESS="noreply@postsider.com"
# EMAIL_FROM_NAME="PostSider"

# === Social Media API Settings (add as needed) ═══════════════════════════════
X_URL=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# === AI (optional) ═══════════════════════════════════════════════════════════
OPENAI_API_KEY=""

# === Misc ════════════════════════════════════════════════════════════════════
API_LIMIT=60
NEXT_PUBLIC_DISCORD_SUPPORT=""
NEXT_PUBLIC_POLOTNO=""

# === Payment / Billing (Polar.sh — Merchant of Record) ══════════════════════
# Without POLAR_ACCESS_TOKEN, all orgs get ULTIMATE tier (all features)
POLAR_ACCESS_TOKEN=""
POLAR_SERVER="production"
POLAR_WEBHOOK_SECRET=""
POLAR_ORGANIZATION_ID=""
# Plan tier -> Polar product id mapping: see .env.example (POLAR_PRODUCT_*)
FEE_AMOUNT=0.05

# === Database credentials (used by docker-compose) ═══════════════════════════
POSTGRES_USER=postsider
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=postsider_prod

# === MinIO credentials (used by docker-compose — must match above) ═══════════
# Already set via MINIO_ACCESS_KEY / MINIO_SECRET_KEY above

# === DbGate ═══════════════════════════════════════════════════════════════════
DBGATE_PASSWORD=CHANGE_ME_DBGATE_PASSWORD
