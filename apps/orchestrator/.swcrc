{
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": false,
      "decorators": true,
      "dynamicImport": true
    },
    "target": "es2020",
    "baseUrl": "../..",
    "paths": {
      "@postsider/backend/*": ["apps/backend/src/*"],
      "@postsider/helpers/*": ["libraries/helpers/src/*"],
      "@postsider/nestjs-libraries/*": ["libraries/nestjs-libraries/src/*"],
      "@postsider/orchestrator/*": ["apps/orchestrator/src/*"]
    },
    "keepClassNames": true,
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "loose": true
  },
  "module": {
    "type": "commonjs",
    "strict": false,
    "strictMode": true,
    "lazy": false,
    "noInterop": false
  },
  "sourceMaps": true,
  "minify": false
}
