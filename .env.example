# Copy this file to .env before starting Docker Compose. Replace every CHANGE_ME
# value with a unique secret. Never commit the resulting .env file.
# Generate values with `openssl rand -base64 48` (app keys) or `openssl rand -hex 24` (passwords).

# === Public URLs ===============================================================
# Replace social.example.com with the domain served by your HTTPS reverse proxy.
FRONTEND_URL="https://social.example.com"
BACKEND_URL="https://social.example.com"
NEXT_PUBLIC_BACKEND_URL="https://social.example.com/api"
BACKEND_INTERNAL_URL="http://localhost:3000"
MAIN_URL=""
TZ="UTC"
PORT=3000
ORCHESTRATOR_PORT=3002
NODE_ENV="production"

# === Required secrets and database ============================================
POSTGRES_USER="postsider"
POSTGRES_PASSWORD="CHANGE_ME_GENERATE_A_UNIQUE_DATABASE_PASSWORD"
POSTGRES_DB="postsider"
DATABASE_URL="postgresql://postsider:${POSTGRES_PASSWORD}@postgres:5432/postsider"
REDIS_URL="redis://redis:6379"
JWT_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_JWT_SECRET"
ENCRYPTION_KEY="CHANGE_ME_GENERATE_A_32_BYTE_BASE64_ENCRYPTION_KEY"
TEMPORAL_POSTGRES_PASSWORD="CHANGE_ME_GENERATE_A_UNIQUE_TEMPORAL_DATABASE_PASSWORD"

# === Docker storage (MinIO) ===================================================
STORAGE_PROVIDER="minio"
MINIO_ENDPOINT="http://minio:9000"
MINIO_ACCESS_KEY="CHANGE_ME_GENERATE_A_MINIO_ACCESS_KEY"
MINIO_SECRET_KEY="CHANGE_ME_GENERATE_A_LONG_MINIO_SECRET_KEY"
MINIO_BUCKET="postsider-media"
MINIO_PUBLIC_URL="https://social.example.com/storage"

# === Background workers ========================================================
TEMPORAL_ADDRESS="temporal:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_API_KEY=""
TEMPORAL_TLS="false"
# Required for scheduled-post recovery, evergreen recycling and media cleanup.
RUN_CRON="true"

# === Self-hosting ==============================================================
IS_GENERAL="true"
NEXT_PUBLIC_SELF_HOSTED="true"
DISABLE_REGISTRATION="false"
NEXT_PUBLIC_DISABLE_REGISTRATION="false"
REQUIRE_EMAIL_ACTIVATION="false"
# Do not set NOT_SECURED in a public deployment. Any non-empty value disables
# authentication protections and is intended only for isolated local debugging.
# NOT_SECURED=true

# === Email (optional) ==========================================================
# Leave blank to disable email. Set to "nodemailer" or "resend" only after
# configuring the matching variables below.
EMAIL_PROVIDER=""
EMAIL_FROM_NAME="PostSider"
EMAIL_FROM_ADDRESS=""
RESEND_API_KEY=""
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_SECURE=false

# === Optional external storage =================================================
# Set STORAGE_PROVIDER="cloudflare" to use Cloudflare R2 instead of MinIO.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKETNAME=""
CLOUDFLARE_BUCKET_URL=""
CLOUDFLARE_REGION="auto"

# === Social media OAuth credentials ===========================================
# Add only the credentials for platforms you use. Register each OAuth callback
# at https://social.example.com/integrations/social/<provider>.
X_URL=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
BEEHIIVE_API_KEY=""
BEEHIIVE_PUBLICATION_ID=""
LISTMONK_DOMAIN=""
LISTMONK_USER=""
LISTMONK_API_KEY=""
LISTMONK_LIST_ID=""
LISTMONK_WELCOME_TEMPLATE_ID=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
GOOGLE_GMB_CLIENT_ID=""
GOOGLE_GMB_CLIENT_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
WHOP_CLIENT_ID=""
TELEGRAM_TOKEN=""
TELEGRAM_BOT_NAME=""
NEXT_PUBLIC_TELEGRAM_BOT_NAME=""
NEYNAR_CLIENT_ID=""
NEYNAR_SECRET_KEY=""
EXTENSION_ID=""

# === Optional AI, billing and observability ===================================
OPENAI_API_KEY=""
NEXT_PUBLIC_DISCORD_SUPPORT=""
API_LIMIT=60
# TRUTHINESS-checked: any non-empty value blocks "+" emails.
# DISALLOW_PLUS=true

# Leave all POLAR_* values empty for an unlimited self-hosted instance.
POLAR_ACCESS_TOKEN=""
POLAR_SERVER="sandbox"
POLAR_WEBHOOK_SECRET=""
POLAR_ORGANIZATION_ID=""
POLAR_PRODUCT_STANDARD_MONTHLY=""
POLAR_PRODUCT_STANDARD_YEARLY=""
POLAR_PRODUCT_TEAM_MONTHLY=""
POLAR_PRODUCT_TEAM_YEARLY=""
POLAR_PRODUCT_PRO_MONTHLY=""
POLAR_PRODUCT_PRO_YEARLY=""
POLAR_PRODUCT_ULTIMATE_MONTHLY=""
POLAR_PRODUCT_ULTIMATE_YEARLY=""

# Generic OAuth (optional)
NEXT_PUBLIC_POSTSIDER_OAUTH_DISPLAY_NAME="Authentik"
NEXT_PUBLIC_POSTSIDER_OAUTH_LOGO_URL=""
POSTSIDER_GENERIC_OAUTH="false"
POSTSIDER_OAUTH_URL=""
POSTSIDER_OAUTH_AUTH_URL=""
POSTSIDER_OAUTH_TOKEN_URL=""
POSTSIDER_OAUTH_USERINFO_URL=""
POSTSIDER_OAUTH_CLIENT_ID=""
POSTSIDER_OAUTH_CLIENT_SECRET=""

# Short-link providers (optional)
DUB_TOKEN=""
DUB_API_ENDPOINT=""
DUB_SHORT_LINK_DOMAIN=""
KUTT_API_KEY=""
KUTT_API_ENDPOINT=""
KUTT_SHORT_LINK_DOMAIN=""
SHORT_IO_SECRET_KEY=""
LINK_DRIP_API_KEY=""
LINK_DRIP_API_ENDPOINT=""
LINK_DRIP_SHORT_LINK_DOMAIN=""

# Monitoring and analytics (optional)
SENTRY_SPOTLIGHT=""
NEXT_PUBLIC_SENTRY_DSN=""
DATAFAST_API_KEY=""
NEXT_PUBLIC_FACEBOOK_PIXEL=""
FACEBOOK_PIXEL_ACCESS_TOKEN=""
MEDIA_RETENTION_DAYS=""
RESTRICT_UPLOAD_DOMAINS=""
NEXT_PUBLIC_OVERRIDE_BACKEND_URL=""
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""
MOBILE_APP_SCHEME=""
BOOTSTRAP_ORGANIZATION=""
