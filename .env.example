# KUTT_API_KEY="" # Your Kutt.it API key
# KUTT_API_ENDPOINT="https://kutt.it/api/v2" # Your self-hosted Kutt API endpoint
# KUTT_SHORT_LINK_DOMAIN="kutt.it" # Your self-hosted Kutt domain

# LINK_DRIP_API_KEY="" # Your LinkDrip API key
# LINK_DRIP_API_ENDPOINT="https://api.linkdrip.com/v1/" # Your self-hosted LinkDrip API endpoint
# LINK_DRIP_SHORT_LINK_DOMAIN="dripl.ink" # Your self-hosted LinkDrip domain

# Short-link — uncomment the provider you want and fill in its values
DUB_TOKEN=""
DUB_API_ENDPOINT=""
DUB_SHORT_LINK_DOMAIN=""
KUTT_API_KEY=""
KUTT_API_ENDPOINT=""
KUTT_SHORT_LINK_DOMAIN=""
SHORT_IO_SECRET_KEY=""
LINK_DRIP_API_KEY=""
LINK_DRIP_API_ENDPOINT=""
LINK_DRIP_SHORT_LINK_DOMAIN=""

# Monitoring / analytics (all optional)
SENTRY_SPOTLIGHT=""
NEXT_PUBLIC_SENTRY_DSN=""
DATAFAST_API_KEY=""
NEXT_PUBLIC_FACEBOOK_PIXEL=""
FACEBOOK_PIXEL_ACCESS_TOKEN=""
MEDIA_RETENTION_DAYS=""
RESTRICT_UPLOAD_DOMAINS=""

# Next.js public overrides (optional, leave blank in most setups)
NEXT_PUBLIC_SELF_HOSTED=true
NEXT_PUBLIC_OVERRIDE_BACKEND_URL=""
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""

# Optional integrations (safe to leave blank)
# Deep-link scheme for the companion mobile app, if you use one.
MOBILE_APP_SCHEME=""
# Pre-create an organization with this name on first bootstrap (optional).
BOOTSTRAP_ORGANIZATION=""