# Configuration reference: http://docs.postsider.com/configuration/reference

# === Required Settings
DATABASE_URL="postgresql://postsider-user:postsider-password@localhost:5432/postsider-db-local"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="random string for your JWT secret, make it long"

# Dedicated key for encrypting reversible secrets at rest (provider client
# secrets, instance credentials) using AES-256-GCM. Strongly recommended for
# production. When unset, the app falls back to the legacy AES-256-CBC scheme
# derived from JWT_SECRET (existing ciphertext keeps working either way).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# === This needs to be exactly the URL you're accessing PostSider on
# `BACKEND_URL` is preferred (the agent-bridge backend serves /uploads itself).
# `FRONTEND_URL` is kept as a fallback for legacy deployments where a separate
# web app reverse-proxies static assets.
BACKEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"
# Optional extra origin for CORS allow-list (leave blank to use FRONTEND_URL)
MAIN_URL=""
# App listen port. These defaults run locally out of the box (pnpm dev).
# For production, set BACKEND_URL / FRONTEND_URL / NEXT_PUBLIC_BACKEND_URL to your
# domain (https://app.yourdomain.com); docker-compose.production runs on port 5000.
PORT=3000
NODE_ENV=development
TZ=UTC
ORCHESTRATOR_PORT=3002

## Cloudflare R2 — only required when STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKETNAME=""
CLOUDFLARE_BUCKET_URL=""
CLOUDFLARE_REGION="auto"

# === Common optional Settings

## Email — choose a provider: "resend" or "nodemailer" (SMTP)
EMAIL_PROVIDER="nodemailer"
EMAIL_FROM_NAME="PostSider"
EMAIL_FROM_ADDRESS=""
## Resend (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=""
## SMTP (when EMAIL_PROVIDER=nodemailer)
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_SECURE=false

# Where will social media icons be saved - local, cloudflare, or minio.
# Default is "local" — files go into ./uploads/ relative to project root.
# Switch to "cloudflare" and fill the R2 variables above for cloud storage.
# Switch to "minio" and fill the MinIO variables below for S3-compatible storage.
STORAGE_PROVIDER="local"

# Local uploads directory (used when STORAGE_PROVIDER=local).
# Created automatically during install. The backend serves /uploads/* from here.
UPLOAD_DIRECTORY="./uploads"

# Your upload directory path if you host your files locally, otherwise Cloudflare will be used.
#NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""

# MinIO — only required when STORAGE_PROVIDER=minio
MINIO_ENDPOINT=""
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET=""
MINIO_PUBLIC_URL=""

# Social Media API Settings
X_URL=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
BEEHIIVE_API_KEY=""
BEEHIIVE_PUBLICATION_ID=""
LISTMONK_DOMAIN=""
LISTMONK_USER=""
LISTMONK_API_KEY=""
LISTMONK_LIST_ID=""
LISTMONK_WELCOME_TEMPLATE_ID=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Optional dedicated Google OAuth credentials for Gmail. If left blank, the
# Gmail provider falls back to YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET.
# Make sure the OAuth client has https://www.googleapis.com/auth/gmail.send
# enabled and that ${FRONTEND_URL}/integrations/social/gmail is whitelisted as
# an authorized redirect URI.
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""

# Google My Business
GOOGLE_GMB_CLIENT_ID=""
GOOGLE_GMB_CLIENT_SECRET=""

# Instagram (standalone app, separate from Facebook app above)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# VK
VK_ID=""

# Kick
KICK_CLIENT_ID=""
KICK_SECRET=""

# Twitch
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Farcaster (via Neynar)
NEYNAR_SECRET_KEY=""
NEYNAR_CLIENT_ID=""

# Telegram
TELEGRAM_TOKEN=""

# MeWe
MEWE_APP_ID=""
MEWE_API_KEY=""
MEWE_HOST=""

# Whop
WHOP_CLIENT_ID=""

# X (Twitter) optional toggles. TRUTHINESS-checked: any non-empty value —
# including "false" — turns the toggle ON. Uncomment only to enable.
# DISABLE_X_ANALYTICS=true
# STRIP_LINKS_FROM_X_POSTS=true

# Chrome Extension Settings (for cookie-based platform integrations like Skool)
EXTENSION_ID=""

# Temporal (workflow engine — self-host: leave blank for unauthenticated local cluster)
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_API_KEY=""
TEMPORAL_TLS=false
# Set to "true" on the instance that should run background cron workers
RUN_CRON=true

# Misc Settings
OPENAI_API_KEY=""
NEXT_PUBLIC_DISCORD_SUPPORT=""
# DEV ONLY — disables auth and CSRF. The code checks TRUTHINESS, so even the
# string "false" ENABLES insecure mode (no session cookie -> login breaks,
# CSRF off). Leave commented out unless you are on localhost dev.
# NOT_SECURED=true
# Public API: requests per minute, per organization.
PUBLIC_API_RATE_LIMIT=60
# Dashboard API: requests per hour, per IP.
DASHBOARD_RATE_LIMIT=3000

# Self-host toggles
# Prevent public sign-up. First install (zero orgs) and invited users are always allowed.
# Set to "true" to lock down registration after you've created your account.
DISABLE_REGISTRATION=false
REQUIRE_EMAIL_ACTIVATION=false
# TRUTHINESS-checked: any non-empty value (even "false") BLOCKS "+" emails.
# DISALLOW_PLUS=true

# Payment settings
FEE_AMOUNT=0.05

# Payment settings — Polar.sh (Merchant of Record)
# Organization Access Token from the Polar dashboard (Settings → Developers)
POLAR_ACCESS_TOKEN=""
# "sandbox" while testing, "production" when live
POLAR_SERVER="sandbox"
# Webhook signing secret from the Polar webhook endpoint settings
POLAR_WEBHOOK_SECRET=""
# Your Polar organization id (used for listing products / scoping API calls)
POLAR_ORGANIZATION_ID=""
# Setting POLAR_ACCESS_TOKEN enables billing enforcement; absent means every org is unlimited.
# Map each plan tier + period to its Polar product id.
# In Polar each product has a single billing interval, so monthly and yearly are separate products.
POLAR_PRODUCT_STANDARD_MONTHLY=""
POLAR_PRODUCT_STANDARD_YEARLY=""
POLAR_PRODUCT_TEAM_MONTHLY=""
POLAR_PRODUCT_TEAM_YEARLY=""
POLAR_PRODUCT_PRO_MONTHLY=""
POLAR_PRODUCT_PRO_YEARLY=""
POLAR_PRODUCT_ULTIMATE_MONTHLY=""
POLAR_PRODUCT_ULTIMATE_YEARLY=""

# Developer Settings
IS_GENERAL="true" # required for now
NEXT_PUBLIC_POSTSIDER_OAUTH_DISPLAY_NAME="Authentik"
NEXT_PUBLIC_POSTSIDER_OAUTH_LOGO_URL="https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png"
POSTSIDER_GENERIC_OAUTH="false"
POSTSIDER_OAUTH_URL="https://auth.example.com"
POSTSIDER_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
POSTSIDER_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
POSTSIDER_OAUTH_USERINFO_URL="https://authentik.example.com/application/o/userinfo"
POSTSIDER_OAUTH_CLIENT_ID=""
POSTSIDER_OAUTH_CLIENT_SECRET=""
# POSTSIDER_OAUTH_SCOPE="openid profile email" # default values

# Short Link Service Settings
# DUB_TOKEN="" # Your self-hosted Dub API token
# DUB_API_ENDPOINT="https://api.dub.co" # Your self-hosted Dub API endpoint
# DUB_SHORT_LINK_DOMAIN="dub.sh" # Your self-hosted Dub domain

