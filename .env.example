# Configuration reference: http://docs.postsider.com/configuration/reference

# === Required Settings
DATABASE_URL="postgresql://postsider-user:postsider-password@localhost:5432/postsider-db-local"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="random string for your JWT secret, make it long"

# Dedicated key for encrypting reversible secrets at rest (provider client
# secrets, instance credentials) using AES-256-GCM. Strongly recommended for
# production. When unset, the app falls back to the legacy AES-256-CBC scheme
# derived from JWT_SECRET (existing ciphertext keeps working either way).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# === This needs to be exactly the URL you're accessing PostSider on
# `BACKEND_URL` is preferred (the agent-bridge backend serves /uploads itself).
# `FRONTEND_URL` is kept as a fallback for legacy deployments where a separate
# web app reverse-proxies static assets.
BACKEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"

## Remember to set your public internet IP address in the allow-list for the API token.
##
## Cloudflare is currently required to save things like social media avatars for accounts.
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ACCESS_KEY="your-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_BUCKETNAME="your-bucket-name"
CLOUDFLARE_BUCKET_URL="https://your-bucket-url.r2.cloudflarestorage.com/"
CLOUDFLARE_REGION="auto"

# === Common optional Settings

## This is a dummy key, you must create your own from Resend.
## If this variable exists, user activation is required.
## If it is commented out, users are activated automatically.
#RESEND_API_KEY="RzeTwHijvxvPUerScFcenUZUALuQJzSaGSMJ"
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""
# Public sign-up is disabled by default. Run `pnpm bootstrap` once after
# installation to create the very first admin + organization. Additional
# users join via Settings → Users → Invite from inside the dashboard.
DISABLE_REGISTRATION=true

# Where will social media icons be saved - local or cloudflare.
# Default is "local" — files go into ./uploads/ relative to project root.
# Switch to "cloudflare" and fill the R2 variables below for cloud storage.
STORAGE_PROVIDER="local"

# Local uploads directory (used when STORAGE_PROVIDER=local).
# Created automatically during install. The backend serves /uploads/* from here.
UPLOAD_DIRECTORY="./uploads"

# Your upload directory path if you host your files locally, otherwise Cloudflare will be used.
#NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""

# Social Media API Settings
X_URL=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
BEEHIIVE_API_KEY=""
BEEHIIVE_PUBLICATION_ID=""
LISTMONK_DOMAIN=""
LISTMONK_USER=""
LISTMONK_API_KEY=""
LISTMONK_LIST_ID=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Optional dedicated Google OAuth credentials for Gmail. If left blank, the
# Gmail provider falls back to YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET.
# Make sure the OAuth client has https://www.googleapis.com/auth/gmail.send
# enabled and that ${FRONTEND_URL}/integrations/social/gmail is whitelisted as
# an authorized redirect URI.
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# VK
VK_ID=""

# Kick
KICK_CLIENT_ID=""
KICK_SECRET=""

# Twitch
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Farcaster (via Neynar)
NEYNAR_SECRET_KEY=""
NEYNAR_CLIENT_ID=""

# Telegram
TELEGRAM_TOKEN=""

# Chrome Extension Settings (for cookie-based platform integrations like Skool)
EXTENSION_ID=""

# Misc Settings
OPENAI_API_KEY=""
NEXT_PUBLIC_DISCORD_SUPPORT=""
NEXT_PUBLIC_POLOTNO=""
# NOT_SECURED=false
API_LIMIT=30 # The limit of the public API hour limit

# Payment settings
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_SIGNING_KEY_CONNECT=""

# Payment settings — Polar.sh (Merchant of Record)
# Organization Access Token from the Polar dashboard (Settings → Developers)
POLAR_ACCESS_TOKEN=""
# "sandbox" while testing, "production" when live
POLAR_SERVER="sandbox"
# Webhook signing secret from the Polar webhook endpoint settings
POLAR_WEBHOOK_SECRET=""
# Your Polar organization id (used for listing products / scoping API calls)
POLAR_ORGANIZATION_ID=""
# Setting POLAR_ACCESS_TOKEN enables billing enforcement (like STRIPE_PUBLISHABLE_KEY did).
# Map each plan tier + period to its Polar product id.
# In Polar each product has a single billing interval, so monthly and yearly are separate products.
POLAR_PRODUCT_STANDARD_MONTHLY=""
POLAR_PRODUCT_STANDARD_YEARLY=""
POLAR_PRODUCT_TEAM_MONTHLY=""
POLAR_PRODUCT_TEAM_YEARLY=""
POLAR_PRODUCT_PRO_MONTHLY=""
POLAR_PRODUCT_PRO_YEARLY=""
POLAR_PRODUCT_ULTIMATE_MONTHLY=""
POLAR_PRODUCT_ULTIMATE_YEARLY=""

# Developer Settings
IS_GENERAL="true" # required for now
NEXT_PUBLIC_POSTSIDER_OAUTH_DISPLAY_NAME="Authentik"
NEXT_PUBLIC_POSTSIDER_OAUTH_LOGO_URL="https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png"
POSTSIDER_GENERIC_OAUTH="false"
POSTSIDER_OAUTH_URL="https://auth.example.com"
POSTSIDER_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
POSTSIDER_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
POSTSIDER_OAUTH_USERINFO_URL="https://authentik.example.com/application/o/userinfo"
POSTSIDER_OAUTH_CLIENT_ID=""
POSTSIDER_OAUTH_CLIENT_SECRET=""
# POSTSIDER_OAUTH_SCOPE="openid profile email" # default values

