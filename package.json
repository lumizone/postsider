{
  "name": "postsider",
  "version": "1.1.0",
  "description": "PostSider - open-source social media scheduler for 30+ platforms (backend monorepo)",
  "main": "index.js",
  "license": "AGPL-3.0",
  "homepage": "https://postsider.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumizone/postsider.git"
  },
  "bugs": {
    "url": "https://github.com/lumizone/postsider/issues"
  },
  "keywords": [
    "social-media",
    "scheduler",
    "self-hosted",
    "mcp",
    "nestjs",
    "nextjs"
  ],
  "author": "Lumi Zone Łukasz Blania <lukasz@postsider.com>",
  "engines": {
    "node": ">=20.17.0 <23.0.0"
  },
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "dev": "pnpm run --filter ./apps/orchestrator --filter ./apps/backend --parallel dev",
    "dev-backend": "pnpm run --filter ./apps/backend --parallel dev",
    "pm2": "pnpm run pm2-run",
    "publish-sdk": "pnpm run --filter ./apps/sdk publish",
    "pm2-run": "pnpm run prisma-migrate-deploy && pm2-runtime start ecosystem.config.js",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 pnpm -r --workspace-concurrency=1 --filter ./apps/backend --filter ./apps/orchestrator run build",
    "build:backend": "rm -rf apps/backend/dist && cross-env NODE_OPTIONS=--max-old-space-size=4096 pnpm --filter ./apps/backend run build",
    "build:orchestrator": "rm -rf apps/orchestrator/dist && cross-env NODE_OPTIONS=--max-old-space-size=4096 pnpm --filter ./apps/orchestrator run build",
    "build:sdk": "pnpm --filter ./apps/sdk exec tsup",
    "dev:backend": "rm -rf apps/backend/dist && pnpm --filter ./apps/backend run dev",
    "dev:orchestrator": "rm -rf apps/orchestrator/dist && pnpm --filter ./apps/orchestrator run dev",
    "dev:frontend": "pnpm --filter ./apps/frontend run dev",
    "start:prod:orchestrator": "pnpm --filter ./apps/orchestrator run start",
    "start:prod:backend": "pnpm --filter ./apps/backend run start",
    "dev:docker": "docker compose -f ./docker-compose.dev.yaml up -d",
    "commands:build:development": "pnpm --filter ./apps/commands run build",
    "bootstrap": "pnpm --filter ./apps/commands run bootstrap",
    "prisma-generate": "pnpm dlx prisma@6.5.0 generate --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-db-push": "pnpm dlx prisma@6.5.0 db push --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-db-pull": "pnpm dlx prisma@6.5.0 db pull --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-migrate-dev": "pnpm dlx prisma@6.5.0 migrate dev --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-migrate-deploy": "pnpm exec prisma migrate deploy --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-migrate-status": "pnpm dlx prisma@6.5.0 migrate status --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-reset": "cd ./libraries/nestjs-libraries/src/database/prisma && pnpm dlx prisma@6.5.0 db push --force-reset && pnpx prisma@6.5.0 db push",
    "postinstall": "pnpm run prisma-generate",
    "test": "jest --coverage --reporters=default --reporters=jest-junit --forceExit",
    "test:handles": "jest --runInBand --detectOpenHandles"
  },
