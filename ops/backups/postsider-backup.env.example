# Copy this file to /etc/postsider-backup.env on the VPS after creating the B2 bucket.
# Keep it root-readable only: chmod 600 /etc/postsider-backup.env
# Do not commit the real file.

# Backblaze B2 S3-compatible endpoint and bucket, e.g.:
# RESTIC_REPOSITORY=s3:https://s3.<region>.backblazeb2.com/<bucket-name>
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# A long, separate encryption password. Store it outside git, e.g.
# RESTIC_PASSWORD_FILE=/etc/postsider-backup.password
RESTIC_PASSWORD_FILE=

# Stable Restic host label. It is used with tags to group retention snapshots.
POSTSIDER_BACKUP_HOST=postsider-production

# Database backup targets. These match the live production deployment
# (verified against the running containers), NOT the compose defaults.
POSTGRES_CONTAINER=postsider-postgres
POSTGRES_DATABASE=postsider_prod
POSTGRES_USER=postsider
TEMPORAL_POSTGRES_CONTAINER=postsider-temporal-pg
TEMPORAL_POSTGRES_USER=temporal

# Docker volume/state paths on this VPS.
MINIO_DATA_DIR=/var/lib/docker/volumes/postsider_app_minio-data/_data
N8N_DATA_DIR=/root/.n8n

# Space-separated running containers to stop before copying file data and
# dumping databases. Do not include either PostgreSQL container: they remain up
# for pg_dump. Include every application writer and stateful file service.
#
# The n8n container is named "root-n8n-1" on this host (compose project "root"),
# not "n8n" — the script fails closed on an unknown container, so a wrong name
# here aborts every run instead of producing a torn snapshot.
#
# TRADEOFF, decide before enabling: stopping postsider-app and
# postsider-temporal means a few minutes of nightly downtime, and a post
# scheduled inside that window waits for the restart. Dropping them from this
# list removes the downtime but makes the media/n8n copy merely crash
# consistent rather than coherent with the database dump.
BACKUP_QUIESCE_CONTAINERS="postsider-app postsider-temporal postsider-minio root-n8n-1"
